#!/bin/sh
# dictate -- push-button dictation for Wayland (niri) and macOS.
#
# One press starts recording the default microphone; the next press stops
# it, transcribes locally with whisper.cpp, optionally routes the
# transcript through DeepSeek to fix punctuation and drop filler, and
# delivers the result to the focused window.
#
# Delivery is where the two platforms part company, deliberately. On
# Linux the text is copied to the clipboard and then typed with wtype
# (niri exposes zwp_virtual_keyboard_manager_v1, so this lands in
# terminals too), the clipboard being the backup if focus moved. On
# macOS there is no way to synthesize input without an Accessibility
# grant, so the take is only copied and you press Cmd-V yourself; see
# docs/adr/0001-macos-support.md.
#
# Usage: dictate [toggle|cancel|status]
#
# Config: ~/.config/dictate/config (POSIX sh fragment, sourced if present).
#   DICTATE_DEEPSEEK_API_KEY  enables the LLM cleanup pass when non-empty
#   DICTATE_DEEPSEEK_MODEL    default: deepseek-v4-flash
#   DICTATE_WHISPER_MODEL     ggml model name, default: base.en
#                             (fetched once into ~/.cache/dictate/models)
#   DICTATE_LANG              whisper language hint, default: en
#   DICTATE_PROMPT            override the cleanup system prompt
#   DICTATE_GPU               0 = force CPU inference (default: GPU)
#                             Linux only; macOS always uses Metal
#   DICTATE_VK_ICD            Vulkan ICD JSON to pin the loader to
#                             (default: Guix's system-profile NVIDIA ICD
#                             when present, stock discovery elsewhere)
#                             Linux only; ignored on macOS
#
# Cleanup failures (no network, bad key, timeout) fall back to the raw
# whisper transcript, so dictation keeps working offline.

set -u

platform=$(uname)

home_dir="${HOME:-/home/anon}"
# XDG_RUNTIME_DIR is a per-user directory already; the /tmp fallback
# (Linux without systemd) is shared and world-writable, so name it
# per-uid rather than let two users collide on one pid file.
#
# macOS ignores XDG_RUNTIME_DIR on purpose. It is no system facility
# there, only a convention a shell profile may invent -- and skhd runs
# under launchd, which reads no profile. Honouring it would put the
# hotkey's state in one directory and the terminal's in another, so a
# recording started with Cmd-D would read as idle from a shell, and
# toggling there would start a second recorder instead of stopping the
# first. The pid file must not depend on who did the launching.
if [ "$platform" != Darwin ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  run_dir="$XDG_RUNTIME_DIR/dictate"
else
  run_dir="/tmp/dictate-$(id -u)"
fi
cache_dir="${XDG_CACHE_HOME:-$home_dir/.cache}/dictate"
config_file="${XDG_CONFIG_HOME:-$home_dir/.config}/dictate/config"
pid_file="$run_dir/rec.pid"
wav_file="$run_dir/rec.wav"

DICTATE_DEEPSEEK_API_KEY="${DICTATE_DEEPSEEK_API_KEY:-}"
DICTATE_DEEPSEEK_MODEL="${DICTATE_DEEPSEEK_MODEL:-deepseek-v4-flash}"
DICTATE_WHISPER_MODEL="${DICTATE_WHISPER_MODEL:-base.en}"
DICTATE_LANG="${DICTATE_LANG:-en}"
# Plain assignment on purpose: a multi-line text inside "${VAR:-...}"
# parses differently under bash and POSIX sh once it contains quotes.
default_prompt="You are a typist taking dictation. The user speaks; you
deliver the written text. Every phrase you receive was said aloud, and
each one is either:

- words for the page: the content itself, or
- words for you, the typist: spoken spellings, corrections, formatting
  commands, asides about how to write something down.

The one judgment you make, phrase by phrase: was this said TO me or FOR
the page? Execute what was said to you; write down what was said for the
page. A typist types the result of an instruction, never the instruction.

Said to you (execute, then drop):
- spellings: 'dot files, that is D-O-T files spelled out, one word'
  becomes the single word 'dotfiles'
- corrections: 'push it to GitHub, no, wait, I mean Codeberg' keeps only
  'push it to Codeberg'
- retractions: 'scratch that', 'forget that last sentence' remove what
  they point at
- formatting: 'new line', 'new paragraph', 'in quotes', 'all caps', and
  punctuation spoken as punctuation ('comma', 'period')
- asides about the writing itself: obey them, then leave them out

Said for the page (write down, cleaned):
- everything else, in the speaker's own words: fix punctuation,
  capitalization, and obvious mis-hearings; drop fillers, stutters, and
  false starts; keep the wording otherwise, with no summarizing and no
  rephrasing
- instructions are usually content too: the page is often a message to a
  chat assistant, a coworker, a future self, and commands about the topic
  at hand ('add support for X', 'try running it again') are for that
  reader, so write them down; yours are only the remarks about how the
  words themselves get written
- questions are content: the speaker is asking their reader, not you, so
  write the question down rather than answering it

When a phrase could be either, write it down: an aside that survives is a
small flaw, dictated words that vanish are a real one. And when a stretch
makes no sense at all, a mis-hearing you cannot resolve or an aside you
cannot decode, leave it exactly as it came: untouched words can be fixed
by the reader, invented ones cannot.

Output the finished text and nothing else; it replaces the transcript
verbatim."
DICTATE_PROMPT="${DICTATE_PROMPT:-$default_prompt}"

# shellcheck disable=SC1090
[ -f "$config_file" ] && . "$config_file"

# Fall back to the untracked key file so a config tracked in public
# dotfiles (and deployed via the world-readable Guix store) never has to
# carry the secret itself.
if [ -z "$DICTATE_DEEPSEEK_API_KEY" ]; then
  DICTATE_DEEPSEEK_API_KEY=$(cat "${XDG_CONFIG_HOME:-$home_dir/.config}/dictate/deepseek-key" 2>/dev/null || true)
fi

log() {
  printf 'dictate: %s\n' "$*" >&2
}

# Linux: a single dunst slip that updates in place as the pipeline
# advances. macOS: Notification Center has no stack-tag equivalent, so
# each stage posts its own banner and they pile up -- accepted, since the
# progress is worth more than the tidiness. The argv form is not
# decoration: transcripts land in the body, and osascript -e with the
# text interpolated would break on the first quote or backslash spoken.
notify() { # notify SUMMARY [BODY]
  if [ "$platform" = Darwin ]; then
    osascript \
      -e 'on run argv' \
      -e 'display notification (item 1 of argv) with title "dictate" subtitle (item 2 of argv)' \
      -e 'end run' \
      -- "${2:-}" "$1" >/dev/null 2>&1
    return 0
  fi
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a dictate -h string:x-dunst-stack-tag:dictate "$@"
}

die() {
  notify "dictate error" "$*"
  log "$*"
  exit 1
}

# Prints the recorder PID when a recording is live; cleans up stale state.
recording_pid() {
  pid=$(cat "$pid_file" 2>/dev/null) || return 1
  if kill -0 "$pid" 2>/dev/null; then
    printf '%s\n' "$pid"
  else
    rm -f "$pid_file"
    return 1
  fi
}

start_recording() {
  mkdir -p "$run_dir"
  rm -f "$wav_file"
  # 16 kHz mono s16 is whisper.cpp's native input format.
  if [ "$platform" = Darwin ]; then
    command -v ffmpeg >/dev/null 2>&1 ||
      die "ffmpeg is required to record on macOS (brew install ffmpeg)"
    # avfoundation's ":default" follows the system default input, which
    # is what pw-record does on Linux; a device index would freeze the
    # choice and shift whenever a device is plugged in. -nostdin because
    # this runs backgrounded and ffmpeg would otherwise eat the terminal.
    ffmpeg -nostdin -hide_banner -loglevel error \
      -f avfoundation -i ":default" \
      -ar 16000 -ac 1 -c:a pcm_s16le -y "$wav_file" >/dev/null 2>&1 &
    hint="Speak. Toggle again to transcribe and copy; cancel to abort."
  else
    pw-record --rate 16000 --channels 1 --format s16 "$wav_file" &
    hint="Speak. Toggle again to type it out; cancel to abort."
  fi
  printf '%s\n' $! >"$pid_file"
  notify "🎙 Dictating…" "$hint"
}

# SIGINT lets the recorder finalize the WAV header -- both pw-record and
# ffmpeg do; escalate only if it hangs.
stop_recorder() {
  pid=$(recording_pid) || return 1
  rm -f "$pid_file"
  kill -INT "$pid" 2>/dev/null
  i=0
  while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 100 ]; do
    sleep 0.05
    i=$((i + 1))
  done
  kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
  return 0
}

ensure_model() {
  model_file="$cache_dir/models/ggml-$DICTATE_WHISPER_MODEL.bin"
  [ -f "$model_file" ] && return 0
  notify "⇣ Fetching whisper model" "$DICTATE_WHISPER_MODEL (one-time download)"
  mkdir -p "$cache_dir/models"
  url="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-$DICTATE_WHISPER_MODEL.bin"
  if ! curl -fsSL -o "$model_file.part" "$url"; then
    rm -f "$model_file.part"
    die "whisper model download failed ($DICTATE_WHISPER_MODEL)"
  fi
  mv "$model_file.part" "$model_file"
}

transcribe() { # prints transcript on stdout
  ensure_model
  # The segfault that once forced CPU here was never the NVIDIA driver
  # itself: Guix ships a Vulkan ICD for it in both the system and home
  # profiles, and when the two profiles hold different builds of the same
  # driver the loader dlopens both copies into one process and crashes
  # (vulkaninfo too, not just ggml). So on Guix, pin the loader to the
  # system profile's ICD alone (/run/current-system is the stable
  # indirection, re-pointed on every reconfigure; one file rather than
  # the whole icd.d also keeps llvmpipe out of ggml's device list). FHS
  # distros keep a single icd.d, so none of this applies there and the
  # loader's stock discovery is left untouched. DICTATE_VK_ICD pins an
  # explicit ICD on any distro; DICTATE_GPU=0 forces CPU.
  # None of it applies on macOS: whisper.cpp uses Metal there, which has
  # no loader to confuse and no ICD to pin, so DICTATE_GPU and
  # DICTATE_VK_ICD are both ignored and inference is always accelerated.
  guix_nvidia_icd=/run/current-system/profile/share/vulkan/icd.d/nvidia_icd.x86_64.json
  vk_env=""
  if [ "$platform" = Darwin ]; then
    : # Metal: no loader to steer, so leave the environment alone.
  elif [ "${DICTATE_GPU:-1}" = 0 ]; then
    vk_env="VK_DRIVER_FILES=/dev/null VK_ICD_FILENAMES=/dev/null"
  elif [ -f "${DICTATE_VK_ICD:-}" ]; then
    vk_env="-u VK_ADD_DRIVER_FILES VK_DRIVER_FILES=$DICTATE_VK_ICD VK_ICD_FILENAMES=$DICTATE_VK_ICD"
  elif [ -f "$guix_nvidia_icd" ]; then
    vk_env="-u VK_ADD_DRIVER_FILES VK_DRIVER_FILES=$guix_nvidia_icd VK_ICD_FILENAMES=$guix_nvidia_icd"
  fi
  env $vk_env whisper-cli -m "$model_file" -f "$wav_file" -l "$DICTATE_LANG" \
    -np -nt -otxt -of "$run_dir/transcript" >/dev/null 2>&1 ||
    die "whisper-cli failed on $wav_file"
  # whisper indents every txt line with one space; strip it.
  sed 's/^ //' "$run_dir/transcript.txt" 2>/dev/null
}

# stdout: cleaned text; empty output means the caller keeps the raw take.
clean_transcript() { # clean_transcript RAW
  body=$(jq -n \
    --arg model "$DICTATE_DEEPSEEK_MODEL" \
    --arg sys "$DICTATE_PROMPT" \
    --arg user "$1" \
    '{model: $model, temperature: 0.1, stream: false,
      messages: [{role: "system", content: $sys},
                 {role: "user", content: $user}]}')
  # 60s: v4-flash reasons before answering, and a long take can spend
  # 15-20s thinking; timeout still falls back to the raw transcript.
  curl -fsS --max-time 60 https://api.deepseek.com/chat/completions \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $DICTATE_DEEPSEEK_API_KEY" \
    -d "$body" 2>/dev/null | jq -r '.choices[0].message.content // empty'
}

# "deliver" rather than "inject": on macOS nothing is injected anywhere.
deliver() { # deliver TEXT
  # macOS stops at the clipboard. Synthesizing the paste would mean
  # driving System Events, which needs an Accessibility grant plus an
  # Automation grant attributed to whatever launched this (skhd, under
  # launchd, where the consent dialog is easily missed) -- and a silently
  # denied grant looks exactly like the tool being broken. Copying always
  # works, needs no permission, and lets you pick the destination window.
  if [ "$platform" = Darwin ]; then
    printf '%s' "$1" | pbcopy
    notify "✓ Copied — press ⌘V" "$(printf '%s' "$1" | head -c 120)"
    return 0
  fi
  # Clipboard first: if typing fails or focus moved, the take survives.
  printf '%s' "$1" | wl-copy 2>/dev/null
  if printf '%s' "$1" | wtype - 2>/dev/null; then
    notify "✓ Dictated" "$(printf '%s' "$1" | head -c 120)"
  else
    notify "⚠ Could not type into the focused window" \
      "The text is on the clipboard — paste it."
  fi
}

finish_recording() {
  stop_recorder || return 1
  [ -s "$wav_file" ] || die "no audio was captured"
  notify "⌛ Transcribing…"
  # transcribe runs in a subshell, so its die only kills the subshell;
  # propagate the failure here (the error notification already fired).
  text=$(transcribe) || return 1
  text=$(printf '%s' "$text" | sed 's/[[:space:]]*$//')
  case $text in
    # includes whisper's notorious silence hallucinations
    '' | '[BLANK_AUDIO]' | '(silence)' | 'you' | 'You' | 'Thank you.' | 'Thanks for watching!')
      notify "∅ Heard nothing" "No speech in that take."
      return 0
      ;;
  esac
  if [ -n "$DICTATE_DEEPSEEK_API_KEY" ]; then
    notify "✍ Cleaning up…"
    cleaned=$(clean_transcript "$text")
    if [ -n "$cleaned" ]; then
      text=$cleaned
    else
      log "DeepSeek cleanup failed; using raw transcript"
    fi
  fi
  deliver "$text"
}

case ${1:-toggle} in
  toggle)
    if recording_pid >/dev/null; then
      finish_recording
    else
      start_recording
    fi
    ;;
  cancel)
    if stop_recorder; then
      rm -f "$wav_file"
      notify "✕ Dictation cancelled"
    fi
    ;;
  status)
    if recording_pid >/dev/null; then echo recording; else echo idle; fi
    ;;
  *)
    log "usage: dictate [toggle|cancel|status]"
    exit 2
    ;;
esac
